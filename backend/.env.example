# Application Configuration
DATABASE_URL=sqlite:///./food_calorie.db
LOG_LEVEL=info
ENVIRONMENT=development

# Cloud AI Frontier Engine Keys (Optional for live multimodal cloud reasoning)
# Engine 4 (Gemini 1.5 Flash Context) & Engine 6 (Gemini 2.5 Pro Verifier)
GEMINI_API_KEY=

# Engine 6 Alternative Verifier (Claude 3.7 / Sonnet 4.6)
ANTHROPIC_API_KEY=

# Storage settings
OBJECT_STORAGE_BUCKET=food-calorie-images
OBJECT_STORAGE_ENDPOINT=https://s3.example-region.amazonaws.com
NUTRITION_DB_SOURCE=usda_fdc
